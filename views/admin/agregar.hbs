<div class="container" style="margin:100px auto">
    <div class="row">
        <div class="col-6 offset-3">
            <h4>Agregar una foto</h4>
            <form action="/admin/galeria/agregar" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <input type="text" class="form-control" placeholder="Título o descripción de la foto" name="titulo">
                </div>
                <div class="mb-3">
                    <input type="file" class="form-control" name="imagen" accept="image/*">
                </div>
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a href="/admin/galeria" class="btn btn-outline-secondary">Cancelar</a>
            </form>
            {{#if error}}
                <h5 class="text-danger mt-3">{{message}}</h5>
            {{/if}}
        </div>
    </div>
</div>
